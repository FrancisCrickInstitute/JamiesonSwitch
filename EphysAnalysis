def ensure_dir(p: Path) -> None:
    p.mkdir(parents=True, exist_ok=True)


def nanmed(x) -> float:
    x = np.asarray(x, float)
    return float(np.nanmedian(x)) if x.size else np.nan


def robust_median(x: np.ndarray) -> float:
    return float(np.median(x.astype(float)))


def get_fs(abf: pyabf.ABF) -> float:
    return float(abf.dataRate)


def dvdt_mV_per_ms(v_mV: np.ndarray, fs: float) -> np.ndarray:
    dt = 1.0 / fs
    dv = np.gradient(v_mV.astype(float), dt)   # mV/s
    return dv / 1000.0                         # mV/ms == V/s numerically



def infer_date_and_progid_from_abf_name(fname: str) -> Tuple[Optional[str], Optional[str], bool, bool]:
    stem = Path(fname).stem
    has_events = "events" in stem.lower()
    m_exact = re.match(r"^(\d{4}_\d{2}_\d{2})_(\d{4})$", stem)
    if m_exact:
        return m_exact.group(1), m_exact.group(2), True, has_events
    m_loose = re.search(r"(\d{4}_\d{2}_\d{2}).*?(\d{4})", stem)
    if m_loose:
        return m_loose.group(1), m_loose.group(2), False, has_events
    return None, None, False, has_events


def date_from_txt_filename(txt_path: Path) -> Optional[str]:
    stem = txt_path.stem
    m = re.match(r"^(\d{4})(\d{2})(\d{2})$", stem)
    if m:
        return f"{m.group(1)}_{m.group(2)}_{m.group(3)}"
    m2 = re.match(r"^(\d{4}_\d{2}_\d{2})$", stem)
    if m2:
        return m2.group(1)
    return None


def idx_from_time(t: np.ndarray, time_s: float) -> int:
    if t.size == 0:
        return 0
    i = int(np.searchsorted(t, time_s, side="left"))
    return int(np.clip(i, 0, t.size - 1))


