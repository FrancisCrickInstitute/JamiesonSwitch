            ("ivcc", "AP_mAHP_Vmin_mV", "AP_mAHP_Vmin_mV"),
            ("ivcc", "AP_mAHP_Depth_mV", "AP_mAHP_Depth_mV"),

        ]

        rows = []
        cellsheet_rows = []
        tmp["RunIndex"] = tmp.groupby(["Date", "Cell", "CanonicalProtocol"]).cumcount() + 1

        for (d, c), gcell in tmp.groupby(["Date", "Cell"]):
            row = {"Date": d, "Cell": c}

            if "meta_Metadata_Raw" in gcell.columns:
                vv = gcell["meta_Metadata_Raw"].dropna()
                row["meta_Metadata_Raw"] = vv.iloc[0] if not vv.empty else np.nan
            else:
                row["meta_Metadata_Raw"] = np.nan

            for proto, src, outn in summary_metric_map:
                g = gcell[gcell["CanonicalProtocol"] == proto]
                if src not in g.columns:
                    row[outn] = np.nan
                    continue
                vals = g[src].dropna()
                row[outn] = float(vals.mean()) if not vals.empty else np.nan

            match = df_firing[df_firing["Cell"] == c]
            if not match.empty:
                row["Firing_Type"] = match.iloc[0]["Firing_Type"]
                row["Classification_Reason"] = match.iloc[0]["Classification_Reason"]
            rows.append(row)

            cell_row = {"Date": d, "Cell": c}
            for col in gcell.columns:
                if isinstance(col, str) and col.startswith("meta_"):
                    vv = gcell[col].dropna()
                    if not vv.empty:
                        cell_row[col] = vv.iloc[0]

            for proto, src, outn in cellsheet_metric_map:
                g = gcell[gcell["CanonicalProtocol"] == proto]
                if src not in g.columns:
                    for r in [1, 2, 3]:
                        cell_row[f"{outn}_Run{r}"] = np.nan
                    cell_row[f"{outn}_Avg"] = np.nan
                    continue

                for r in [1, 2, 3]:
                    vv = g.loc[g["RunIndex"] == r, src].dropna()
                    cell_row[f"{outn}_Run{r}"] = float(vv.iloc[0]) if len(vv) > 0 else np.nan

                vv_all = g[src].dropna()
                cell_row[f"{outn}_Avg"] = float(vv_all.mean()) if not vv_all.empty else np.nan

            rmp_avg = cell_row.get("RMP_mV_Avg", np.nan)
            thr_avg = cell_row.get("AP_Threshold_mV_Avg", np.nan)
            cell_row["Thresh_Depol_mV"] = float(thr_avg - rmp_avg) if (np.isfinite(rmp_avg) and np.isfinite(thr_avg)) else np.nan
            if not match.empty:
                cell_row["Firing_Type"] = match.iloc[0]["Firing_Type"]
                cell_row["Classification_Reason"] = match.iloc[0]["Classification_Reason"]
            cellsheet_rows.append(cell_row)

        df_summary_wide = pd.DataFrame(rows)
        for col in requested_summary_cols:
            if col not in df_summary_wide.columns:
                df_summary_wide[col] = np.nan
        df_summary_wide = df_summary_wide[requested_summary_cols].sort_values(["Date", "Cell"])
        df_cellsheet_summary = pd.DataFrame(cellsheet_rows).sort_values(["Date", "Cell"])

    df_iv_voltage_wide = pd.DataFrame()
    df_iv_freq_wide = pd.DataFrame()
    df_iv_lat_wide = pd.DataFrame()
    df_iv_spikes_wide = pd.DataFrame()

    if not df_iv_steps.empty:
        tmp = df_iv_steps.copy()
        tmp["ProgID_sort"] = tmp["ProgID"].astype(str)
        tmp = tmp.sort_values(["Date", "Cell", "ProgID_sort", "Step_pA"])
        tmp["RunIndex"] = tmp.groupby(["Date", "Cell", "File"]).ngroup()
        tmp["RunIndex"] = tmp.groupby(["Date", "Cell"])["RunIndex"].rank(method="dense").astype(int)

        def make_wide(value_col: str, prefix: str) -> pd.DataFrame:
            g = tmp[["Date", "Cell", "Step_pA", "RunIndex", value_col]].copy()
            wide = g.pivot_table(index=["Date", "Cell", "Step_pA"], columns="RunIndex", values=value_col, aggfunc="first")
            wide = wide.rename(columns=lambda k: f"{prefix}_Run{int(k)}")
            wide[f"{prefix}_Avg"] = wide.mean(axis=1, skipna=True)
            return wide.reset_index()

        df_iv_voltage_wide = make_wide("V_ss_mV", "V_ss_mV")
        df_iv_freq_wide = make_wide("Freq_Hz", "SpikesPerStep_Hz")
        df_iv_lat_wide = make_wide("FirstLatency_s", "FirstLatency_s")
        df_iv_spikes_wide = make_wide("Spikes_N", "Spikes_N")

    log("----")
    log("Writing main Excel workbook...")
    with pd.ExcelWriter(output_main_xlsx, engine="openpyxl") as writer:
        df_qc.to_excel(writer, sheet_name="QC", index=False)
        df_meta_global.to_excel(writer, sheet_name="Metadata_Global", index=False)
        df_meta_cell.to_excel(writer, sheet_name="Metadata_Cell", index=False)
        df_firing.to_excel(writer, sheet_name="Firing_Type_Classification", index=False)
        df_firing_counts.to_excel(writer, sheet_name="Firing_Type_Counts", index=False)
        classification_thresholds().to_excel(writer, sheet_name="Thresholds_Used", index=False)
        if not df_runs.empty:
            df_runs.to_excel(writer, sheet_name="Protocol_Runs_Long", index=False)

        if not df_cellsheet_summary.empty:
            for _, r in df_cellsheet_summary.iterrows():
                cell = str(r.get("Cell", "Unknown"))
                date = str(r.get("Date", ""))
                sheet = safe_sheet_name(f"{cell}_Summary")

                df_vert = make_vertical_summary_from_row(r)
                header = pd.DataFrame([
                    {"Metric": "Date", "Run1": date, "Run2": np.nan, "Run3": np.nan, "Avg": np.nan},
                    {"Metric": "Cell", "Run1": cell, "Run2": np.nan, "Run3": np.nan, "Avg": np.nan},
                    {"Metric": "----", "Run1": "Summary metrics", "Run2": np.nan, "Run3": np.nan, "Avg": np.nan},
                ])
                df_out = pd.concat([header, df_vert], ignore_index=True)
                df_out.to_excel(writer, sheet_name=sheet, index=False, startrow=0)

                start = len(df_out) + 2

                def write_ivcc_block(df_block: pd.DataFrame, title: str, startrow: int) -> int:
                    if df_block.empty:
                        return startrow
                    pd.DataFrame([{"": title}]).to_excel(
                        writer, sheet_name=sheet, index=False, header=False, startrow=startrow
                    )
                    df_block.to_excel(writer, sheet_name=sheet, index=False, startrow=startrow + 1)
                    return startrow + 2 + len(df_block) + 1

                if not df_iv_voltage_wide.empty:
                    blk = df_iv_voltage_wide[(df_iv_voltage_wide["Date"] == date) & (df_iv_voltage_wide["Cell"] == cell)].copy().sort_values("Step_pA")
                    start = write_ivcc_block(blk, "IVCC: V_ss (mV) per Step (pA)", start)

                if not df_iv_spikes_wide.empty:
                    blk = df_iv_spikes_wide[(df_iv_spikes_wide["Date"] == date) & (df_iv_spikes_wide["Cell"] == cell)].copy().sort_values("Step_pA")
                    start = write_ivcc_block(blk, "IVCC: Spikes_N per Step (pA)", start)

                if not df_iv_lat_wide.empty:
                    blk = df_iv_lat_wide[(df_iv_lat_wide["Date"] == date) & (df_iv_lat_wide["Cell"] == cell)].copy().sort_values("Step_pA")
                    start = write_ivcc_block(blk, "IVCC: First spike latency (s) per Step (pA)", start)

        if not df_summary_wide.empty:
