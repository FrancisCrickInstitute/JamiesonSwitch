def warn_join(w: List[str]) -> str:
    return "; ".join(w) if w else ""


# =========================
# Main
# =========================
def main():
    in_dir = Path(INPUT_PATH).expanduser().resolve()
    out_dir = Path(OUTPUT_PATH).expanduser().resolve()
    ensure_dir(out_dir)

    txt_path = find_mapping_txt(in_dir)
    if txt_path is None:
        raise RuntimeError(f"No .txt notes file found in {in_dir}")

    txt_date = date_from_txt_filename(txt_path)
    meta, cell_blocks, _ = parse_txt_cells_and_metadata(txt_path)

    logfile = out_dir / f"{txt_path.stem}_log.txt"
    global LOGGER
    LOGGER = DualLogger(logfile)

    output_main_xlsx = out_dir / f"{txt_path.stem}_output.xlsx"
    output_1ap_xlsx = out_dir / f"{txt_path.stem}_1AP.xlsx"

    txt_map: Dict[Tuple[str, str], str] = {}
    for cb in cell_blocks:
        for pid, pname in cb.prog_map.items():
            txt_map[(cb.cell_label, pid)] = pname

    df_meta_global = pd.DataFrame([{"TxtFile": txt_path.name, "TxtDate": txt_date, **meta}])
    df_meta_cell = pd.DataFrame([{
        "Cell": cb.cell_label,
        "CellHeaderRaw": " | ".join([x.strip() for x in cb.header_lines if x.strip()]),
        "ProgMapCount": len(cb.prog_map),
    } for cb in cell_blocks])

    abf_files = sorted(in_dir.glob("*.abf"))

    log(f"INPUT_PATH:  {in_dir}")
    log(f"OUTPUT_PATH: {out_dir}")
    log(f"TXT notes:   {txt_path.name}")
    log(f"TXT date:    {txt_date}")
    log(f"Found {len(cell_blocks)} cell blocks in TXT")
    log(f"Found {len(abf_files)} .abf files in folder")
    log(f"Log file:    {logfile.name}")
    log(f"IVCC step window (FIXED): {IVCC_STEP_WIN_START_S:.3f} -> {IVCC_STEP_WIN_END_S:.3f} s (rebound after end)")
    log("----")

    qc_rows: List[QCRow] = []
    summary_runs = []
    ivcc_steps_runs = []
    ivcc_1ap_runs = []
    rheo_sweeps_runs = []
    i0_spike_times_rows = []

    oneap_waveforms: Dict[str, Dict[int, Dict[str, np.ndarray]]] = {}

    def infer_cell_from_filename(stem: str) -> str:
        m = re.search(r"(Cell\s*\d+)", stem, re.IGNORECASE)
        if m:
            num = re.search(r"\d+", m.group(1)).group(0)
            return f"Cell {num}"
        return "Unknown"

    current_cell = None

    for i, abf_path in enumerate(abf_files, start=1):
        warnings: List[str] = []
        fdate, progid, pattern_ok, has_events = infer_date_and_progid_from_abf_name(abf_path.name)
        date_match = (txt_date is not None and fdate == txt_date)

        log(f"[{i}/{len(abf_files)}] Checking {abf_path.name}")

        cell = infer_cell_from_filename(abf_path.stem)

        txt_proto = None
        if progid is not None:
            pid_str = str(progid).zfill(4)
            txt_proto = txt_map.get((cell, pid_str))
            if txt_proto is None:
                for (c, p), nm in txt_map.items():
                    if p == pid_str:
                        txt_proto = nm
                        cell = c
                        break
            progid = pid_str

        canon = canonical_protocol(txt_proto) if txt_proto else None

        if cell != current_cell and cell != "Unknown":
            current_cell = cell
            log(f"\n=== Now processing {cell} ===")

        if has_events:
            log("  SKIP: contains 'Events' in filename")
            qc_rows.append(QCRow(abf_path.name, txt_date, fdate, date_match, pattern_ok, has_events,
                                 progid, cell, txt_proto, canon, "skip_events_suffix", "SKIP", "", ""))
            continue
        if not pattern_ok:
            log("  SKIP: filename not exactly YYYY_MM_DD_####.abf")
            qc_rows.append(QCRow(abf_path.name, txt_date, fdate, date_match, pattern_ok, has_events,
                                 progid, cell, txt_proto, canon, "skip_bad_filename_pattern", "SKIP",
                                 "Bad filename pattern", ""))
            continue
        if txt_date is not None and not date_match:
            log(f"  SKIP: wrong date (file {fdate} != txt {txt_date})")
            qc_rows.append(QCRow(abf_path.name, txt_date, fdate, date_match, pattern_ok, has_events,
                                 progid, cell, txt_proto, canon, "skip_wrong_date", "SKIP",
                                 "Wrong date", ""))
            continue
        if canon == "IGNORE":
            log(f"  SKIP: ignored protocol '{txt_proto}'")
            qc_rows.append(QCRow(abf_path.name, txt_date, fdate, True, True, False,
                                 progid, cell, txt_proto, canon, "skip_ignore_protocol", "SKIP",
                                 "Ignore i0 at -60", ""))
            continue
        if canon is None:
            log(f"  SKIP: unknown protocol '{txt_proto}'")
            qc_rows.append(QCRow(abf_path.name, txt_date, fdate, True, True, False,
                                 progid, cell, txt_proto, canon, "skip_unknown_protocol", "SKIP",
                                 "Unknown protocol", ""))
            continue

        try:
            abf = pyabf.ABF(str(abf_path))
        except Exception as e:
            log(f"  FAIL: couldn't load ABF: {e}")
            qc_rows.append(QCRow(abf_path.name, txt_date, fdate, True, True, False,
                                 progid, cell, txt_proto, canon, "load_abf", "FAIL", "", str(e)))
            continue

        fs = get_fs(abf)
        log(f"  OK: Cell={cell}, ProgID={progid}, Protocol='{txt_proto}' -> {canon} (fs={fs:.1f} Hz, sweeps={abf.sweepCount})")

        base = {
            "Date": txt_date,
            "Cell": cell,
            "ProgID": progid,
            "File": abf_path.name,
            "TxtProtocol": txt_proto,
            "CanonicalProtocol": canon,
        }
        for k, v in meta.items():
            base[f"meta_{k}"] = v

        try:
            if canon == "i0":
                out, spk = analyze_i0(abf)
                cls, reason, warn = classify_firing(
                    out["i0_freq_hz"], out["i0_n_spikes"], out["i0_cv2"],
                    out["i0_isi_cv"], out["i0_pause_fraction"])
                summary_runs.append({**base, **out, "Firing_Type": cls,
                                     "Classification_Reason": reason,
                                     "Classification_Warning": warn})
                for st in spk:
                    i0_spike_times_rows.append({**base, "SpikeTime_s": float(st)})
                log(f"  DONE: i0 spikes={out.get('i0_n_spikes')} freq={out.get('i0_freq_hz', np.nan):.3f}Hz CV2={out.get('i0_cv2', np.nan)}")
                qc_rows.append(QCRow(abf_path.name, txt_date, fdate, True, True, False,
                                     progid, cell, txt_proto, canon, "analyze_i0", "OK",
                                     warn_join(warnings), ""))

            elif canon == "rheo":
                out, df_rheo = analyze_rheo(abf)
                summary_runs.append({**base, **out})

                for _, r in df_rheo.iterrows():
                    rheo_sweeps_runs.append({**base, **r.to_dict()})

                log(
                    "  DONE: rheo "
                    f"thr={out.get('AP_Thresh_mV', np.nan)}mV "
                    f"rheobase={out.get('Rheobase_pA', np.nan)}pA "
                    f"ramp_spikes={out.get('Ramp_SpikeCount_N', np.nan)} "
                    f"block={out.get('Ramp_DepolBlock_bool', np.nan)} "
                    f"block_I={out.get('Ramp_DepolBlock_Current_pA', np.nan)}pA"
                )
                qc_rows.append(QCRow(abf_path.name, txt_date, fdate, True, True, False,
                                     progid, cell, txt_proto, canon, "analyze_rheo", "OK",
                                     warn_join(warnings), ""))

            elif canon == "ivcc":
                summ, df_steps, df_1ap, wave_snips = analyze_ivcc(abf)
                summary_runs.append({**base, **summ})

                if df_steps.empty:
                    warnings.append("IVCC: no valid sweeps/steps detected (check sweepC/time window)")
                    log("  WARN: IVCC produced no step rows")
                else:
                    n_unique = df_steps["Step_pA"].nunique() if "Step_pA" in df_steps.columns else "NA"
                    log(f"  IVCC: rows={len(df_steps)} unique steps={n_unique}")

                for _, r in df_steps.iterrows():
                    ivcc_steps_runs.append({**base, **r.to_dict()})
                for _, r in df_1ap.iterrows():
                    ivcc_1ap_runs.append({**base, **r.to_dict()})

                if cell not in oneap_waveforms:
                    oneap_waveforms[cell] = {}
                if progid is not None and progid.isdigit():
                    oneap_waveforms[cell][int(progid)] = wave_snips

                log(
                    "  DONE: ivcc "
                    f"Rin={summ.get('InputResistance_GOhm', np.nan)} GΩ "
                    f"Tau={summ.get('TimeConstant_ms', np.nan)} ms "
                    f"Cm={summ.get('Capacitance_pF', np.nan)} pF "
                    f"MaxStepFreq={summ.get('MaxStepFreq_Hz', np.nan)} Hz "
                    f"Adapt={summ.get('AdaptationIndex', np.nan)}"
                )
                qc_rows.append(QCRow(abf_path.name, txt_date, fdate, True, True, False,
                                     progid, cell, txt_proto, canon, "analyze_ivcc", "OK",
                                     warn_join(warnings), ""))


        except Exception as e:
            log(f"  FAIL during analysis: {e}")
            qc_rows.append(QCRow(abf_path.name, txt_date, fdate, True, True, False,
                                 progid, cell, txt_proto, canon, f"analyze_{canon}", "FAIL",
                                 warn_join(warnings), str(e)))
            continue

    df_qc = pd.DataFrame([asdict(r) for r in qc_rows])
    df_runs = pd.DataFrame(summary_runs)
    df_iv_steps = pd.DataFrame(ivcc_steps_runs)
    df_iv_1ap = pd.DataFrame(ivcc_1ap_runs)
    df_rheo_sweeps = pd.DataFrame(rheo_sweeps_runs)
    df_i0_times = pd.DataFrame(i0_spike_times_rows)
    # TXT contains the full roster, including silent cells with empty spike-time sheets.
