    log("Writing 1AP waveform workbook...")
    sheets_written = 0
    with pd.ExcelWriter(output_1ap_xlsx, engine="openpyxl") as writer:
        for cell, by_pid in sorted(oneap_waveforms.items(), key=lambda x: x[0]):
            pids = sorted(by_pid.keys())
            runs = []
            for pid in pids:
                swsn = by_pid[pid]
                if not swsn:
                    continue
                chosen = None
                for sw in sorted(swsn.keys()):
                    if chosen is None:
                        chosen = swsn[sw]
                    if "Step_pA" in swsn[sw]:
                        if chosen is None or swsn[sw]["Step_pA"] < chosen["Step_pA"]:
                            chosen = swsn[sw]
                if chosen is not None:
                    runs.append(chosen)

            if not runs:
                continue

            t_ms = runs[0]["t_ms"]
            df = pd.DataFrame({"time_ms": t_ms})

            V_mat, D_mat = [], []
            for i_run, sn in enumerate(runs, start=1):
                df[f"V_Run{i_run}"] = sn["v_mV"]
                df[f"dVdt_Run{i_run}"] = sn["dvdt_V_per_s"]
                V_mat.append(sn["v_mV"])
                D_mat.append(sn["dvdt_V_per_s"])

            V_mat = np.vstack(V_mat)
            D_mat = np.vstack(D_mat)
            df["V_Avg"] = np.nanmean(V_mat, axis=0)
            df["dVdt_Avg"] = np.nanmean(D_mat, axis=0)

            df.to_excel(writer, sheet_name=safe_sheet_name(cell), index=False)
            sheets_written += 1

        if sheets_written == 0:
            pd.DataFrame({
                "Message": ["No IVCC first-AP waveforms were available to export."]
            }).to_excel(writer, sheet_name="No_1AP_Data", index=False)
            log("  WARN: no 1AP waveform sheets were available; wrote placeholder sheet instead")

