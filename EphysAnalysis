def analyze_i0(abf: pyabf.ABF) -> Tuple[dict, np.ndarray]:
    """Analyse spontaneous firing in confirmed I=0 current-clamp recordings.

    Sweep times are concatenated for export, but *interval metrics* are
    calculated only between spikes within the same sweep (not over boundaries).
    Duration includes silent sweeps; a valid recording with zero APs is silent.
    """
    fs = get_fs(abf)
    all_times, all_isis, rmp_vals = [], [], []
    offset_s = 0.0
    valid_sweeps = 0
    for sw in range(abf.sweepCount):
        abf.setSweep(sw, channel=0)
        if str(abf.sweepUnitsY).strip().lower() != "mv":
            continue
        v = np.asarray(abf.sweepY, float)
        if len(v) < 2:
            continue
        valid_sweeps += 1
        rmp_vals.append(robust_median(v[:min(len(v), int(IVCC_BASELINE_WINDOW_S * fs))]))
        indices = np.array([sp["thr_idx"] for sp in detect_spikes_dvdt(
            v, fs, dvdt_thresh_V_per_s=DV_DT_THRESH_I0_V_PER_S)], dtype=float)
        times = indices / fs
        all_times.extend((offset_s + times).tolist())
        if len(times) >= 2:
            all_isis.extend(np.diff(times).tolist())
        offset_s += len(v) / fs
    if not valid_sweeps:
        raise ValueError("No valid mV current-clamp sweeps in I0 recording")

    spike_times = np.asarray(all_times, float)
    isi = np.asarray(all_isis, float)
    met = compute_spike_train_metrics(spike_times, offset_s)
    # Replace concatenated-sweep ISI statistics with within-sweep values.
    if len(isi):
        met["isi_mean_s"] = float(np.mean(isi))
        met["isi_median_s"] = float(np.median(isi))
        met["isi_p10_s"] = float(np.quantile(isi, 0.1))
        met["isi_p90_s"] = float(np.quantile(isi, 0.9))
        met["isi_cv"] = float(np.std(isi, ddof=1) / np.mean(isi)) if len(isi) >= 2 and np.mean(isi) > 0 else np.nan
    else:
        for k in ("isi_mean_s", "isi_median_s", "isi_p10_s", "isi_p90_s", "isi_cv"):
            met[k] = np.nan
    # Compute CV2 only from adjacent ISIs within the SAME sweep.
    cv2_by_sweep = []
    for sw in range(abf.sweepCount):
        abf.setSweep(sw, channel=0)
        if str(abf.sweepUnitsY).strip().lower() != "mv":
            continue
        indices = [sp["thr_idx"] for sp in detect_spikes_dvdt(
            np.asarray(abf.sweepY, float), fs,
            dvdt_thresh_V_per_s=DV_DT_THRESH_I0_V_PER_S)]
        d = np.diff(np.asarray(indices, float)) / fs
        if len(d) >= 2:
            cv2_by_sweep.extend((2 * np.abs(np.diff(d)) / (d[:-1] + d[1:])).tolist())
    met["cv2"] = float(np.median(cv2_by_sweep)) if cv2_by_sweep else np.nan
    pause_fraction = float(np.mean(isi > PAUSE_ISI_THRESHOLD_SECONDS)) if len(isi) else np.nan
    burst_fraction = float(np.mean(isi < BURSTLIKE_ISI_THRESHOLD_SECONDS)) if len(isi) else np.nan
    out = {
        "RMP_mV": nanmed(rmp_vals),
        "i0_freq_hz": met["firing_hz"],
        "i0_n_spikes": met["n_spikes"],
        "i0_isi_mean_s": met["isi_mean_s"],
        "i0_isi_median_s": met["isi_median_s"],
        "i0_isi_p10_s": met["isi_p10_s"],
        "i0_isi_p90_s": met["isi_p90_s"],
        "i0_isi_cv": met["isi_cv"],
        "i0_cv2": met["cv2"],
        "i0_pause_fraction": pause_fraction,
        "i0_burstlike_fraction": burst_fraction,
        "i0_fano_1s": met["fano_1s"],
        "i0_rate_stability_cv_5s": met["rate_stability_cv_5s"],
        "i0_rhythmicity_index": met["rhythmicity_index"],
        "i0_rhythm_peak_lag_s": met["rhythm_peak_lag_s"],
        "i0_duration_s": offset_s,
        "i0_valid_sweeps": valid_sweeps,
    }
    return out, spike_times


# =============================================================================
# Spontaneous firing classification (I0 only)
# =============================================================================
# These are operational descriptors, not validated neuron identities or a
# formal burst-detection algorithm. Adjust thresholds before comparing groups.
SPARSE_HZ_THRESHOLD = 0.05
MIN_SPIKES_FOR_PATTERN_CLASSIFICATION = 4
TONIC_MEDIAN_CV2_MAX = 0.50
TONIC_ISI_CV_MAX = 0.80
PAUSE_ISI_THRESHOLD_SECONDS = 5.0
TONIC_MAX_PAUSE_FRACTION = 0.20
BURSTLIKE_ISI_THRESHOLD_SECONDS = 0.10  # descriptive only


def classify_firing(frequency_hz, n_spikes, cv2, isi_cv, pause_fraction,
                    has_i0: bool = True) -> Tuple[str, str, str]:
    """Return (firing class, reason, warning), using the second script's rules.

    A missing I0 recording is NEVER treated as a silent recording.
    """
    if not has_i0:
        return "No I0 data", "No successfully analysed I0 recording", ""
    if not np.isfinite(frequency_hz):
        return "Unclassified", "Recording duration or frequency unavailable", ""
    if n_spikes == 0 or frequency_hz <= 0:
        return "Silent / no detected spikes", "I0 recording present; zero spikes detected", ""
    if frequency_hz < SPARSE_HZ_THRESHOLD:
        return "Sparse firing / near-silent", f"Rate < {SPARSE_HZ_THRESHOLD:g} Hz", ""
    if n_spikes < MIN_SPIKES_FOR_PATTERN_CLASSIFICATION:
        return "Sparse firing / too few spikes for pattern", f"Fewer than {MIN_SPIKES_FOR_PATTERN_CLASSIFICATION} detected spikes", ""
    if not np.isfinite(cv2):
        return "Unclassified pattern", "CV2 unavailable (insufficient within-sweep intervals)", ""
    tonic = (cv2 <= TONIC_MEDIAN_CV2_MAX
             and (not np.isfinite(isi_cv) or isi_cv <= TONIC_ISI_CV_MAX)
             and (not np.isfinite(pause_fraction) or pause_fraction <= TONIC_MAX_PAUSE_FRACTION))
    warning = "ISI CV and/or pause fraction unavailable; CV2-driven classification" if (not np.isfinite(isi_cv) or not np.isfinite(pause_fraction)) else ""
    if tonic:
        return "Regular tonic firing", "CV2, available ISI CV, and pause fraction satisfy tonic thresholds", warning
    reasons = []
    if cv2 > TONIC_MEDIAN_CV2_MAX:
        reasons.append("CV2 above threshold")
    if np.isfinite(isi_cv) and isi_cv > TONIC_ISI_CV_MAX:
        reasons.append("ISI CV above threshold")
    if np.isfinite(pause_fraction) and pause_fraction > TONIC_MAX_PAUSE_FRACTION:
        reasons.append("long-pause fraction above threshold")
    return "Irregular firing", "; ".join(reasons), warning


def make_firing_classification(roster: pd.DataFrame, runs: pd.DataFrame) -> pd.DataFrame:
    """One row per roster cell; summarise ALL successfully recorded I0 runs."""
    recs = []
    i0 = runs[runs["CanonicalProtocol"] == "i0"] if not runs.empty else pd.DataFrame()
    for _, cellrow in roster.iterrows():
        cell = cellrow["Cell"]
        g = i0[i0["Cell"] == cell] if not i0.empty else pd.DataFrame()
        result = {"Date": cellrow.get("Date"), "Cell": cell,
                  "CellHeaderRaw": cellrow.get("CellHeaderRaw"),
                  "I0_Runs_N": len(g)}
        if g.empty:
            rate, count, cv2, isi_cv, pause = (np.nan, 0, np.nan, np.nan, np.nan)
            duration = 0.0
        else:
            duration = float(g["i0_duration_s"].sum())
            count = int(g["i0_n_spikes"].sum())
            rate = count / duration if duration > 0 else np.nan
            cv2 = float(g["i0_cv2"].mean())
            isi_cv = float(g["i0_isi_cv"].mean())
            pause = float(g["i0_pause_fraction"].mean())
        cls, reason, warning = classify_firing(rate, count, cv2, isi_cv, pause, not g.empty)
        result.update({"Firing_Type": cls, "Classification_Reason": reason,
                       "Classification_Warning": warning,
                       "I0_TotalDuration_s": duration if not g.empty else np.nan,
                       "I0_N_Spikes": count if not g.empty else np.nan,
                       "FiringRate_Hz_For_Classification": rate,
                       "CV2_For_Classification": cv2,
                       "ISI_CV_For_Classification": isi_cv,
                       "Pause_Fraction_For_Classification": pause,
                       "BurstLike_ISI_Fraction": float(g["i0_burstlike_fraction"].mean()) if not g.empty else np.nan})
        recs.append(result)
    return pd.DataFrame(recs)


def classification_thresholds() -> pd.DataFrame:
    return pd.DataFrame([
        ("Sparse_Hz_Threshold", SPARSE_HZ_THRESHOLD, "Positive firing below this is near-silent"),
        ("Minimum_Spikes_For_Pattern", MIN_SPIKES_FOR_PATTERN_CLASSIFICATION, "Minimum spike count for tonic/irregular classification"),
        ("Tonic_CV2_Max", TONIC_MEDIAN_CV2_MAX, "Mean of per-run median within-sweep CV2"),
        ("Tonic_ISI_CV_Max", TONIC_ISI_CV_MAX, "Where available"),
        ("Pause_ISI_Threshold_s", PAUSE_ISI_THRESHOLD_SECONDS, "Long pause definition"),
        ("Tonic_Max_Pause_Fraction", TONIC_MAX_PAUSE_FRACTION, "Where available"),
        ("BurstLike_ISI_Threshold_s", BURSTLIKE_ISI_THRESHOLD_SECONDS, "Descriptive only; not a burst classifier"),
    ], columns=["Setting", "Value", "Description"])


def analyze_rheo(abf: pyabf.ABF) -> Tuple[dict, pd.DataFrame]:
    fs = get_fs(abf)

    thr_vals = []
    rheo_vals = []
    ramp_spike_counts = []
    ramp_max_instfreqs = []
    ramp_last_currents = []
    depol_block_flags = []
    depol_block_currents = []
    depol_block_vms = []

    per_sweep_rows = []

    for sw in range(abf.sweepCount):
        abf.setSweep(sw, channel=0)
        if abf.sweepUnitsY.lower() != "mv":
            continue

        v = abf.sweepY.astype(float)

        try:
            cmd = abf.sweepC.astype(float)
            cmd_units = getattr(abf, "sweepUnitsC", None)
            cmd = cmd * unit_to_scale_to_pA(cmd_units)
        except Exception:
            cmd = None

        ramp_a, ramp_b = find_ramp_window_from_command(cmd, fs, v.size)

        all_spikes = detect_spikes_dvdt(
            v,
            fs,
            dvdt_thresh_V_per_s=DV_DT_THRESH_RHEO_V_PER_S,
            min_peak_mV=None,
            min_amp_from_thresh_mV=RHEO_MIN_AP_AMP_FROM_THRESH_MV,
        )
        spikes = subset_spikes_to_window(all_spikes, ramp_a, ramp_b)
        ramp_met = compute_ramp_metrics(v, cmd, fs, spikes, ramp_a, ramp_b)

        ap_thr = np.nan
        rheo = np.nan
        if spikes:
            s0 = spikes[0]
            ap_thr = float(s0["thr_mV"])
            if cmd is not None and cmd.size == v.size:
                rheo = float(cmd[s0["thr_idx"]])

            thr_vals.append(ap_thr)
            if np.isfinite(rheo):
                rheo_vals.append(rheo)

        ramp_spike_counts.append(float(ramp_met["Ramp_SpikeCount_N"]))
        if np.isfinite(ramp_met["Ramp_MaxInstFreq_Hz"]):
            ramp_max_instfreqs.append(float(ramp_met["Ramp_MaxInstFreq_Hz"]))
        if np.isfinite(ramp_met["Ramp_LastSpikeCurrent_pA"]):
            ramp_last_currents.append(float(ramp_met["Ramp_LastSpikeCurrent_pA"]))
        depol_block_flags.append(float(ramp_met["Ramp_DepolBlock_bool"]))
        if np.isfinite(ramp_met["Ramp_DepolBlock_Current_pA"]):
            depol_block_currents.append(float(ramp_met["Ramp_DepolBlock_Current_pA"]))
        if np.isfinite(ramp_met["Ramp_DepolBlock_Vm_mV"]):
            depol_block_vms.append(float(ramp_met["Ramp_DepolBlock_Vm_mV"]))

        per_sweep_rows.append({
            "Sweep": sw,
            "RampStart_s": float(ramp_met["RampStart_s"]),
            "RampEnd_s": float(ramp_met["RampEnd_s"]),
            "RampDuration_s": float(ramp_met["RampDuration_s"]),
            "AP_Thresh_mV": float(ap_thr) if np.isfinite(ap_thr) else np.nan,
            "Rheobase_pA": float(rheo) if np.isfinite(rheo) else np.nan,
            "Ramp_SpikeCount_N": int(ramp_met["Ramp_SpikeCount_N"]),
            "Ramp_MaxInstFreq_Hz": float(ramp_met["Ramp_MaxInstFreq_Hz"]) if np.isfinite(ramp_met["Ramp_MaxInstFreq_Hz"]) else np.nan,
            "Ramp_LastSpikeCurrent_pA": float(ramp_met["Ramp_LastSpikeCurrent_pA"]) if np.isfinite(ramp_met["Ramp_LastSpikeCurrent_pA"]) else np.nan,
            "Ramp_DepolBlock_bool": float(ramp_met["Ramp_DepolBlock_bool"]),
            "Ramp_DepolBlock_Current_pA": float(ramp_met["Ramp_DepolBlock_Current_pA"]) if np.isfinite(ramp_met["Ramp_DepolBlock_Current_pA"]) else np.nan,
            "Ramp_DepolBlock_Vm_mV": float(ramp_met["Ramp_DepolBlock_Vm_mV"]) if np.isfinite(ramp_met["Ramp_DepolBlock_Vm_mV"]) else np.nan,
        })

    df_sweeps = pd.DataFrame(per_sweep_rows)

    out = {
        "AP_Thresh_mV": nanmed(thr_vals),
        "Rheobase_pA": nanmed(rheo_vals),
        "Ramp_SpikeCount_N": nanmed(ramp_spike_counts),
        "Ramp_MaxInstFreq_Hz": nanmed(ramp_max_instfreqs),
        "Ramp_LastSpikeCurrent_pA": nanmed(ramp_last_currents),
        "Ramp_DepolBlock_bool": float(np.max(depol_block_flags)) if len(depol_block_flags) else np.nan,
        "Ramp_DepolBlock_Current_pA": nanmed(depol_block_currents),
        "Ramp_DepolBlock_Vm_mV": nanmed(depol_block_vms),
    }
    return out, df_sweeps


