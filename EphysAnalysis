def safe_sheet_name(name: str, max_len: int = 31) -> str:
    bad = r'[:\\/?*\[\]]'
    s = re.sub(bad, "_", str(name))
    return s[:max_len]


def make_vertical_summary_from_row(row: pd.Series) -> pd.DataFrame:
    """
    Convert one Summary_Wide row into a vertical table:
    Metric | Run1 | Run2 | Run3 | Avg

    Handles both:
    1) classic *_Run1/_Run2/_Run3/_Avg columns
    2) simplified wide summaries that only contain *_Avg or bare metric columns
    """
    meta_rows = []
    for k, v in row.items():
        if isinstance(k, str) and k.startswith("meta_") and pd.notna(v):
            meta_rows.append({"Metric": k, "Run1": v, "Run2": np.nan, "Run3": np.nan, "Avg": np.nan})

    metrics = {}
    bare_metrics = {}

    for k, v in row.items():
        if not isinstance(k, str):
            continue
        if k in ("Date", "Cell"):
            continue
        if k.startswith("meta_"):
            continue

        m = re.match(r"^(.*)_(Run[123]|Avg)$", k)
        if m:
            base = m.group(1)
            suffix = m.group(2)
            metrics.setdefault(base, {})[suffix] = v
        else:
            bare_metrics[k] = v

    out_rows = []
    for base in sorted(metrics.keys()):
        d = metrics[base]
        out_rows.append({
            "Metric": base,
            "Run1": d.get("Run1", np.nan),
            "Run2": d.get("Run2", np.nan),
            "Run3": d.get("Run3", np.nan),
            "Avg": d.get("Avg", np.nan),
        })

    for base in sorted(bare_metrics.keys()):
        out_rows.append({
            "Metric": base,
            "Run1": np.nan,
            "Run2": np.nan,
            "Run3": np.nan,
            "Avg": bare_metrics[base],
        })

    return pd.DataFrame(meta_rows + out_rows)


# =========================
# TXT parsing
# =========================
@dataclass
class TxtCellBlock:
    cell_label: str
    header_lines: List[str]
    prog_map: Dict[str, str]


def find_mapping_txt(folder: Path) -> Optional[Path]:
    txts = sorted(folder.glob("*.txt"))
    if not txts:
        return None
    return max(txts, key=lambda p: p.stat().st_size)


def parse_txt_cells_and_metadata(txt_path: Path) -> Tuple[Dict[str, str], List[TxtCellBlock], List[str]]:
    lines = txt_path.read_text(errors="ignore").splitlines()
    cell_pat = re.compile(r"^\s*Cell\s+(\d+)\b", re.IGNORECASE)
    map_pat = re.compile(r"^\s*(\d{4})\s*[-=]\s*(.+?)\s*$")  # accepts "=" or "-"

    global_header: List[str] = []
    cells: List[TxtCellBlock] = []
    cur: Optional[TxtCellBlock] = None
    seen_first_cell = False

    for ln in lines:
        mcell = cell_pat.match(ln)
        if mcell:
            seen_first_cell = True
            if cur is not None:
                cells.append(cur)
            cur = TxtCellBlock(
                cell_label=f"Cell {mcell.group(1)}",
                header_lines=[ln],
                prog_map={},
            )
            continue

        if not seen_first_cell:
            global_header.append(ln)
            continue

        assert cur is not None
        mmap = map_pat.match(ln)
        if mmap:
            pid, name = mmap.group(1), mmap.group(2).strip()
            cur.prog_map[pid] = name
        else:
            cur.header_lines.append(ln)

    if cur is not None:
        cells.append(cur)

    meta = {}
    raw = " | ".join([x.strip() for x in global_header if x.strip()])
    if raw:
        meta["Metadata_Raw"] = raw

    for ln in global_header:
        l = ln.strip()
        if not l:
            continue
        m = re.match(r"^([^:=]{2,40})\s*[:=]\s*(.+)$", l)
        if m:
            key = re.sub(r"\s+", "_", m.group(1).strip().lower())
            meta[key] = m.group(2).strip()

    joined = " ".join(global_header).lower()
    if "male" in joined:
        meta["sex"] = "Male"
    elif "female" in joined:
        meta["sex"] = "Female"

    return meta, cells, global_header


# =========================
# Protocol normalization
# =========================
def normalize_protocol_name(name: str) -> str:
    n = name.strip().lower()
    n = re.sub(r"\s+", " ", n)
    return n


def canonical_protocol(name: str) -> Optional[str]:
    if not name:
        return None
    n = normalize_protocol_name(name)

    if n.startswith("i0") and "-60" in n:
        return "IGNORE"

    if n == "i0" or n.startswith("i0 "):
        return "i0"


    if "ivcc" in n:
        return "ivcc"

    if n.startswith("rheo") or "rheobase" in n or "ramp" in n:
        return "rheo"

    return None


# =========================
# AP detection + spike features
# =========================
def detect_spikes_dvdt(
    v_mV: np.ndarray,
    fs: float,
    dvdt_thresh_V_per_s: float = 10.0,
    min_peak_mV: Optional[float] = -10.0,
    min_amp_from_thresh_mV: Optional[float] = None,
    refractory_s: float = 0.002,
) -> List[dict]:
    dvdt = dvdt_mV_per_ms(v_mV, fs)  # mV/ms == V/s numerically
    above = dvdt > dvdt_thresh_V_per_s
    crossings = np.where(np.logical_and(above[1:], ~above[:-1]))[0] + 1
    if crossings.size == 0:
        return []

    spikes = []
    refr = int(refractory_s * fs)
    last = -10**12

    for i in crossings:
        if i - last < refr:
            continue

        win = int(0.005 * fs)
        j2 = min(v_mV.size, i + win)
        peak_idx = i + int(np.argmax(v_mV[i:j2]))
        peak_mV = float(v_mV[peak_idx])
        thr_mV = float(v_mV[i])
        amp_from_thresh_mV = peak_mV - thr_mV

        if min_peak_mV is not None and peak_mV < min_peak_mV:
            continue
        if min_amp_from_thresh_mV is not None and amp_from_thresh_mV < min_amp_from_thresh_mV:
            continue

        half = thr_mV + 0.5 * amp_from_thresh_mV

        up = v_mV[i:peak_idx + 1]
        up_cross = np.where(up >= half)[0]
        up_idx = i + int(up_cross[0]) if up_cross.size else i

        down = v_mV[peak_idx:]
        down_cross = np.where(down <= half)[0]
        down_idx = peak_idx + int(down_cross[0]) if down_cross.size else peak_idx

        spikes.append({
            "thr_idx": int(i),
            "thr_mV": thr_mV,
            "peak_idx": int(peak_idx),
            "peak_mV": peak_mV,
            "amp_from_thresh_mV": float(amp_from_thresh_mV),
            "halfwidth_s": float((down_idx - up_idx) / fs),
            "dvdt_max_V_per_s": float(np.max(dvdt[i:min(v_mV.size, i + win)])),
        })
        last = i

    return spikes


def extract_peak_aligned_snippet(
    v: np.ndarray,
    fs: float,
    peak_idx: int,
    pre_ms: float = AP_SNIP_PRE_MS,
    post_ms: float = AP_SNIP_POST_MS,
):
    pre = int((pre_ms / 1000.0) * fs)
    post = int((post_ms / 1000.0) * fs)
    a = max(0, peak_idx - pre)
    b = min(v.size, peak_idx + post)
    snip = v[a:b].astype(float)
    target = pre + post
    if snip.size < target:
        snip = np.concatenate([snip, np.full(target - snip.size, np.nan)])
    t_ms = (np.arange(target) - pre) / fs * 1000.0
    dvdt = dvdt_mV_per_ms(snip, fs)
    return t_ms, snip, dvdt


def local_ap_baseline(v: np.ndarray, fs: float, thr_idx: int, pre_ms: float = AP_LOCAL_BASELINE_PRE_MS) -> float:
    w = max(1, int((pre_ms / 1000.0) * fs))
    a = max(0, thr_idx - w)
    b = max(a + 1, thr_idx)
    return float(np.median(v[a:b]))


def spike_features_from_indices(v: np.ndarray, fs: float, thr_idx: int, peak_idx: int) -> dict:
    v = v.astype(float)
    dvdt = dvdt_mV_per_ms(v, fs)

    Vbase = local_ap_baseline(v, fs, thr_idx)
    Vth = float(v[thr_idx])
    Vpk = float(v[peak_idx])

    v10 = Vth + 0.1 * (Vpk - Vth)
    v90 = Vth + 0.9 * (Vpk - Vth)
    rise_seg = v[thr_idx:peak_idx + 1]
    i10 = np.where(rise_seg >= v10)[0]
    i90 = np.where(rise_seg >= v90)[0]
    rise_10_90_ms = np.nan
    if i10.size and i90.size:
        rise_10_90_ms = (int(i90[0]) - int(i10[0])) / fs * 1000.0

    half = Vth + 0.5 * (Vpk - Vth)
    up = v[thr_idx:peak_idx + 1]
    up_cross = np.where(up >= half)[0]
    up_idx = thr_idx + int(up_cross[0]) if up_cross.size else thr_idx
    down = v[peak_idx:]
    down_cross = np.where(down <= half)[0]
    down_idx = peak_idx + int(down_cross[0]) if down_cross.size else peak_idx
    halfwidth_ms = (down_idx - up_idx) / fs * 1000.0

    max_dvdt = float(np.max(dvdt[thr_idx:min(v.size, thr_idx + int(0.01 * fs))]))
    win = int(0.01 * fs)
    a = max(0, peak_idx - win)
    b = min(v.size, peak_idx + win)
    min_dvdt = float(np.min(dvdt[a:b])) if b > a else np.nan

    def window_min(win_ms):
        a_ms, b_ms = win_ms
        i1 = peak_idx + int((a_ms / 1000.0) * fs)
        i2 = peak_idx + int((b_ms / 1000.0) * fs)
        i1 = max(0, min(v.size - 1, i1))
        i2 = max(i1 + 1, min(v.size, i2))
        seg = v[i1:i2]
        if seg.size < 2:
            return np.nan, np.nan
        j = int(np.argmin(seg))
        vmin = float(seg[j])
        t_ms = (i1 + j - peak_idx) / fs * 1000.0
        return vmin, t_ms

    raw_fVmin, ft = window_min(FAHP_WIN_MS)
    raw_mVmin, mt = window_min(MAHP_WIN_MS)

    fAHP_present = np.isfinite(raw_fVmin) and (raw_fVmin < Vbase)
    mAHP_present = np.isfinite(raw_mVmin) and (raw_mVmin < Vbase)

    fVmin = float(raw_fVmin) if fAHP_present else np.nan
    mVmin = float(raw_mVmin) if mAHP_present else np.nan

    fAHP_depth = float(Vbase - raw_fVmin) if fAHP_present else np.nan
    mAHP_depth = float(Vbase - raw_mVmin) if mAHP_present else np.nan

    adp_mV = np.nan
    adp_t = np.nan
    if np.isfinite(fVmin):
        i1 = peak_idx + int((ADP_WIN_MS[0] / 1000.0) * fs)
        i2 = peak_idx + int((ADP_WIN_MS[1] / 1000.0) * fs)
        i1 = max(0, min(v.size - 1, i1))
        i2 = max(i1 + 1, min(v.size, i2))
        seg = v[i1:i2]
        if seg.size:
            j = int(np.argmax(seg))
            vmax = float(seg[j])
            adp_mV = vmax - float(fVmin)
            adp_t = (i1 + j - peak_idx) / fs * 1000.0

    return {
        "LocalBaseline_mV": float(Vbase),
        "Vth_mV": Vth,
        "Threshold_fromBaseline_mV": float(Vth - Vbase),
        "Vpeak_mV": Vpk,
        "AP_Amp_fromThresh_mV": float(Vpk - Vth),
        "AP_Amp_fromBaseline_mV": float(Vpk - Vbase),
        "Halfwidth_ms": float(halfwidth_ms),
        "Rise10_90_ms": float(rise_10_90_ms),
        "Max_dVdt_V_per_s": float(max_dvdt),
        "Min_dVdt_V_per_s": float(min_dvdt),
        "fAHP_Vmin_mV": float(fVmin) if np.isfinite(fVmin) else np.nan,
        "fAHP_Depth_mV": float(fAHP_depth) if np.isfinite(fAHP_depth) else np.nan,
        "fAHP_t_ms": float(ft) if fAHP_present else np.nan,
        "mAHP_Vmin_mV": float(mVmin) if np.isfinite(mVmin) else np.nan,
        "mAHP_Depth_mV": float(mAHP_depth) if np.isfinite(mAHP_depth) else np.nan,
        "mAHP_t_ms": float(mt) if mAHP_present else np.nan,
        "ADP_mV": float(adp_mV),
        "ADP_t_ms": float(adp_t),
    }


def adaptation_index_from_spikes(spikes: List[dict], fs: float) -> float:
    if len(spikes) < 3:
        return np.nan
    isi_s = np.diff([s["thr_idx"] for s in spikes]) / fs
    isi_s = isi_s[isi_s > 0]
    if isi_s.size < 2:
        return np.nan
    first_isi = float(isi_s[0])
    last_isi = float(isi_s[-1])
    if first_isi <= 0:
        return np.nan
    return float(last_isi / first_isi)


# =========================
# I0 spike train metrics
# =========================
def rhythmicity_index(spike_times_s: np.ndarray, duration_s: float) -> Tuple[float, float]:
    if duration_s <= 0 or spike_times_s.size < 3:
        return np.nan, np.nan

    dt = RHYTHM_BIN_S
    nb = int(np.ceil(duration_s / dt))
    b = np.zeros(nb, float)
    idx = np.clip((spike_times_s / dt).astype(int), 0, nb - 1)
    for k in idx:
        b[k] += 1.0

    ac = np.correlate(b, b, mode="full")
    ac = ac[ac.size // 2:]
    lags = np.arange(ac.size) * dt

    ac0 = ac[1:]
    l0 = lags[1:]
    if np.max(ac0) <= 0:
        return np.nan, np.nan
    acn = ac0 / np.max(ac0)

    a, bb = RHYTHM_PEAK_SEARCH_S
    m = (l0 >= a) & (l0 <= bb)
    if not np.any(m):
        return np.nan, np.nan

    seg = acn[m]
    seg_l = l0[m]
    pi = int(np.argmax(seg))
    peak = float(seg[pi])
    peak_lag = float(seg_l[pi])

    m2 = (l0 >= 0) & (l0 <= peak_lag)
    trough = float(np.min(acn[m2])) if np.any(m2) else np.nan

    denom = peak + trough
    ri = (peak - trough) / denom if (np.isfinite(trough) and denom > 1e-9) else np.nan
    return ri, peak_lag


def compute_spike_train_metrics(spike_times_s: np.ndarray, duration_s: float) -> dict:
    out = {}
    n = spike_times_s.size
    out["n_spikes"] = int(n)
    out["firing_hz"] = float(n / duration_s) if duration_s > 0 else np.nan

    if n < 2:
        for k in [
            "isi_mean_s", "isi_median_s", "isi_p10_s", "isi_p90_s", "isi_cv", "cv2",
            "fano_1s", "rate_stability_cv_5s", "rhythmicity_index", "rhythm_peak_lag_s"
        ]:
            out[k] = np.nan
        return out

    isis = np.diff(spike_times_s)
    out["isi_mean_s"] = float(np.mean(isis))
    out["isi_median_s"] = float(np.median(isis))
    out["isi_p10_s"] = float(np.quantile(isis, 0.10))
    out["isi_p90_s"] = float(np.quantile(isis, 0.90))
    out["isi_cv"] = float(np.std(isis) / np.mean(isis)) if np.mean(isis) > 0 else np.nan

    if isis.size >= 2:
        isi1, isi2 = isis[:-1], isis[1:]
        out["cv2"] = float(np.mean(2 * np.abs(isi2 - isi1) / (isi2 + isi1)))
    else:
        out["cv2"] = np.nan

    if duration_s > 0:
        nb = int(np.ceil(duration_s / FANO_BIN_S))
        edges = np.linspace(0, nb * FANO_BIN_S, nb + 1)
        counts, _ = np.histogram(spike_times_s, bins=edges)
        m = np.mean(counts)
        v = np.var(counts)
        out["fano_1s"] = float(v / m) if m > 0 else np.nan

        nb2 = int(np.ceil(duration_s / RATE_STABILITY_BIN_S))
        edges2 = np.linspace(0, nb2 * RATE_STABILITY_BIN_S, nb2 + 1)
        c2, _ = np.histogram(spike_times_s, bins=edges2)
        m2 = np.mean(c2)
        sd2 = np.std(c2)
        out["rate_stability_cv_5s"] = float(sd2 / m2) if m2 > 0 else np.nan
    else:
        out["fano_1s"] = np.nan
        out["rate_stability_cv_5s"] = np.nan

    ri, lag = rhythmicity_index(spike_times_s, duration_s)
    out["rhythmicity_index"] = float(ri)
    out["rhythm_peak_lag_s"] = float(lag)
    return out


# =========================
# IVCC helper functions
# =========================
def step_steady_state(v: np.ndarray, fs: float, a: int, b: int) -> float:
    w = int(IVCC_STEADY_WINDOW_S * fs)
    aa = max(a, b - w)
    return float(np.median(v[aa:b]))


def tau_step_preference_rank(step_pA: float) -> int:
    prefs = list(TAU_FIT_STEPS_PA)
    try:
        return prefs.index(float(step_pA))
    except ValueError:
        return len(prefs) + int(round(abs(float(step_pA))))


def fit_tau_from_step_crossing(v: np.ndarray, fs: float, step_on_idx: int, step_end_idx: int, fit_ms: float = TAU_FIT_WINDOW_MS) -> dict:
    out = {
        "tau_s": np.nan,
        "baseline_mV": np.nan,
        "steady_mV": np.nan,
        "delta_mV": np.nan,
        "r2": np.nan,
        "rmse_mV": np.nan,
        "method": "",
    }

    if step_end_idx <= step_on_idx + int(0.02 * fs):
        return out

    base_a = max(0, step_on_idx - int(0.05 * fs))
    baseline = float(np.median(v[base_a:step_on_idx])) if step_on_idx > base_a else float(v[step_on_idx])

    ss_w = int(IVCC_STEADY_WINDOW_S * fs)
    ss_a = max(step_on_idx, step_end_idx - ss_w)
    steady = float(np.median(v[ss_a:step_end_idx])) if step_end_idx > ss_a else np.nan
    if not np.isfinite(steady):
        return out

    delta = steady - baseline
    out["baseline_mV"] = float(baseline)
    out["steady_mV"] = float(steady)
    out["delta_mV"] = float(delta)

    if abs(delta) < TAU_MIN_DEFLECTION_MV:
        return out

    fit_end_idx = min(v.size, step_end_idx, step_on_idx + int((fit_ms / 1000.0) * fs))
    if fit_end_idx <= step_on_idx + 2:
        return out

    seg = v[step_on_idx:fit_end_idx].astype(float)
    target = baseline + (1.0 - np.exp(-1.0)) * delta

    if delta < 0:
        cross = np.where(seg <= target)[0]
    else:
        cross = np.where(seg >= target)[0]
    if cross.size == 0:
        return out

    j = int(cross[0])
    if j == 0:
        tau_s = 0.0
    else:
        y0 = float(seg[j - 1])
        y1 = float(seg[j])
        if not np.isfinite(y0) or not np.isfinite(y1) or abs(y1 - y0) < 1e-12:
            frac = 1.0
        else:
            frac = float(np.clip((target - y0) / (y1 - y0), 0.0, 1.0))
        tau_s = ((j - 1) + frac) / fs

    tau_ms = tau_s * 1000.0
    if tau_ms < TAU_MIN_MS or tau_ms > TAU_MAX_MS:
        return out

    out["tau_s"] = float(tau_s)
    out["method"] = "63pct_crossing"
    return out


def fit_tau_from_step_exp(v: np.ndarray, fs: float, step_on_idx: int, step_end_idx: int, fit_ms: float = TAU_FIT_WINDOW_MS) -> dict:
    out = {
        "tau_s": np.nan,
        "baseline_mV": np.nan,
        "steady_mV": np.nan,
        "delta_mV": np.nan,
        "r2": np.nan,
        "rmse_mV": np.nan,
        "method": "",
    }

    if step_end_idx <= step_on_idx + int(0.02 * fs):
        return out

    base_a = max(0, step_on_idx - int(0.05 * fs))
    baseline = float(np.median(v[base_a:step_on_idx])) if step_on_idx > base_a else float(v[step_on_idx])

    ss_w = int(IVCC_STEADY_WINDOW_S * fs)
    ss_a = max(step_on_idx, step_end_idx - ss_w)
    steady = float(np.median(v[ss_a:step_end_idx])) if step_end_idx > ss_a else np.nan
    if not np.isfinite(steady):
        return out

    delta = steady - baseline
    out["baseline_mV"] = float(baseline)
    out["steady_mV"] = float(steady)
    out["delta_mV"] = float(delta)

    if delta >= 0:
        return out
    if abs(delta) < TAU_MIN_DEFLECTION_MV:
        return out

    fit_end_idx = min(v.size, step_end_idx, step_on_idx + int((fit_ms / 1000.0) * fs))
    if fit_end_idx <= step_on_idx + 5:
        return out

    y = v[step_on_idx:fit_end_idx].astype(float)
    x = np.arange(y.size, dtype=float) / fs

    def exp_model(t_s, v_inf, amp, tau_s):
        return v_inf + amp * np.exp(-t_s / tau_s)

    amp0 = baseline - steady
    tau0 = min(max((fit_ms / 1000.0) / 3.0, TAU_MIN_MS / 1000.0), TAU_MAX_MS / 1000.0)

    lower_v = min(np.min(y), steady) - 20.0
    upper_v = max(np.max(y), baseline) + 20.0

    try:
        popt, _ = curve_fit(
            exp_model,
            x,
            y,
            p0=(steady, amp0, tau0),
            bounds=(
                [lower_v, 0.0, TAU_MIN_MS / 1000.0],
                [upper_v, max(200.0, abs(amp0) * 5.0 + 20.0), TAU_MAX_MS / 1000.0],
            ),
            maxfev=20000,
        )
    except Exception:
        return out

    v_inf, amp, tau_s = [float(z) for z in popt]
    if amp <= 0:
        return out

    yhat = exp_model(x, v_inf, amp, tau_s)
    ss_res = float(np.sum((y - yhat) ** 2))
    ss_tot = float(np.sum((y - np.mean(y)) ** 2))
    r2 = float(1.0 - ss_res / ss_tot) if ss_tot > 1e-12 else np.nan
    rmse = float(np.sqrt(np.mean((y - yhat) ** 2)))

    tau_ms = tau_s * 1000.0
    if tau_ms < TAU_MIN_MS or tau_ms > TAU_MAX_MS:
        return out
    if np.isfinite(r2) and r2 < TAU_MIN_R2:
        return out
    if np.isfinite(rmse) and rmse > TAU_MAX_RMSE_MV:
        return out

    out["tau_s"] = float(tau_s)
    out["r2"] = float(r2)
    out["rmse_mV"] = float(rmse)
    out["method"] = "exp_fit"
    return out


def fit_tau_from_step(v: np.ndarray, t: np.ndarray, fs: float, step_on_idx: int, step_end_idx: int, fit_ms: float = TAU_FIT_WINDOW_MS) -> dict:
    """
    Robust tau estimate for small hyperpolarizing IVCC steps.

    Priority:
      1) single-exponential fit to the early charging phase
      2) fallback 63.2% crossing estimate if the fit fails
    """
    fit_res = fit_tau_from_step_exp(v, fs, step_on_idx, step_end_idx, fit_ms=fit_ms)
    if np.isfinite(fit_res["tau_s"]):
        return fit_res
    return fit_tau_from_step_crossing(v, fs, step_on_idx, step_end_idx, fit_ms=fit_ms)


def select_best_tau_candidate(candidates: List[dict]) -> Optional[dict]:
    if not candidates:
        return None

    exp_candidates = [c for c in candidates if c.get("method") == "exp_fit" and np.isfinite(c.get("tau_s", np.nan))]
    if exp_candidates:
        exp_candidates = sorted(
            exp_candidates,
            key=lambda c: (
                tau_step_preference_rank(c.get("Step_pA", np.nan)),
                np.inf if not np.isfinite(c.get("rmse_mV", np.nan)) else c.get("rmse_mV", np.nan),
                -np.inf if not np.isfinite(c.get("r2", np.nan)) else -c.get("r2", np.nan),
            )
        )
        best_pref = tau_step_preference_rank(exp_candidates[0].get("Step_pA", np.nan))
        same_pref = [c for c in exp_candidates if tau_step_preference_rank(c.get("Step_pA", np.nan)) == best_pref]
        same_pref = sorted(
            same_pref,
            key=lambda c: (
                np.inf if not np.isfinite(c.get("rmse_mV", np.nan)) else c.get("rmse_mV", np.nan),
                -np.inf if not np.isfinite(c.get("r2", np.nan)) else -c.get("r2", np.nan),
            )
        )
        return same_pref[0]

    cross_candidates = [c for c in candidates if np.isfinite(c.get("tau_s", np.nan))]
    if not cross_candidates:
        return None

    cross_candidates = sorted(
        cross_candidates,
        key=lambda c: (
            tau_step_preference_rank(c.get("Step_pA", np.nan)),
            abs(c.get("delta_mV", np.nan)) if np.isfinite(c.get("delta_mV", np.nan)) else np.inf,
        )
    )
    return cross_candidates[0]


def compute_sag_metrics(v: np.ndarray, fs: float, a: int, b: int) -> Tuple[float, float]:
    pre = int(0.05 * fs)
    base_a = max(0, a - pre)
    baseline = float(np.median(v[base_a:a])) if a > base_a else float(np.median(v[:max(1, int(0.05 * fs))]))

    e1 = a + int((SAG_EARLY_MS[0] / 1000.0) * fs)
    e2 = a + int((SAG_EARLY_MS[1] / 1000.0) * fs)
    e1 = max(a, min(b - 1, e1))
    e2 = max(e1 + 1, min(b, e2))
    vmin = float(np.min(v[e1:e2])) if e2 > e1 else np.nan

    w = int((SAG_STEADY_LAST_MS / 1000.0) * fs)
    ss_a = max(a, b - w)
    vsteady = float(np.median(v[ss_a:b])) if b > ss_a else np.nan

    sag = vsteady - vmin if (np.isfinite(vsteady) and np.isfinite(vmin)) else np.nan
    denom = baseline - vmin
    sag_ratio = sag / denom if (np.isfinite(sag) and abs(denom) > 1e-9) else np.nan
    return float(sag), float(sag_ratio)


def detect_rebound_spikes(v: np.ndarray, fs: float, step_end_idx: int) -> Tuple[int, float]:
    w = int((REBOUND_WIN_MS / 1000.0) * fs)
    a = step_end_idx
    b = min(v.size, step_end_idx + w)
    spikes = detect_spikes_dvdt(v[a:b], fs, dvdt_thresh_V_per_s=DV_DT_THRESH_IVCC_V_PER_S)
    if not spikes:
        return 0, np.nan
    return len(spikes), float(spikes[0]["thr_idx"] / fs)


# =========================
# Rheo / ramp helper functions
# =========================
def find_ramp_window_from_command(cmd_pA: Optional[np.ndarray], fs: float, npts: int) -> Tuple[int, int]:
    """
    Fixed ramp timing:
    ramp starts at 2.15 s and ends at 7.15 s.
    """
    a = int(round(RHEO_RAMP_START_S * fs))
    b = int(round(RHEO_RAMP_END_S * fs))

    a = max(0, min(npts - 1, a))
    b = max(a + 1, min(npts, b))
    return a, b


def subset_spikes_to_window(spikes: List[dict], a: int, b: int) -> List[dict]:
    return [s for s in spikes if a <= s["thr_idx"] < b]


def compute_ramp_metrics(v: np.ndarray, cmd_pA: Optional[np.ndarray], fs: float, spikes: List[dict], ramp_a: int, ramp_b: int) -> dict:
    """
    Compute extra ramp metrics:
    - spike count during ramp
    - max instantaneous freq during ramp
    - last spike current during ramp
    - conservative depolarization block call
    """
    out = {
        "RampStart_s": float(ramp_a / fs),
        "RampEnd_s": float(ramp_b / fs),
        "RampDuration_s": float((ramp_b - ramp_a) / fs),
        "Ramp_SpikeCount_N": int(len(spikes)),
        "Ramp_MaxInstFreq_Hz": np.nan,
        "Ramp_LastSpikeCurrent_pA": np.nan,
        "Ramp_DepolBlock_bool": 0.0,
        "Ramp_DepolBlock_Current_pA": np.nan,
        "Ramp_DepolBlock_Vm_mV": np.nan,
    }

    if len(spikes) >= 2:
        isi_s = np.diff([s["thr_idx"] for s in spikes]) / fs
        isi_s = isi_s[isi_s > 0]
        if isi_s.size:
            out["Ramp_MaxInstFreq_Hz"] = float(1.0 / np.min(isi_s))

    if not spikes:
        return out

    last_spike = spikes[-1]
    if cmd_pA is not None and cmd_pA.size == v.size:
        out["Ramp_LastSpikeCurrent_pA"] = float(cmd_pA[last_spike["thr_idx"]])

    if len(spikes) < RHEO_BLOCK_MIN_SPIKES:
        return out
    if cmd_pA is None or cmd_pA.size != v.size:
        return out

    last_thr_idx = int(last_spike["thr_idx"])
    last_peak_idx = int(last_spike["peak_idx"])
    remaining_s = (ramp_b - last_peak_idx) / fs
    if remaining_s < RHEO_BLOCK_MIN_REMAINDER_S:
        return out

    I_last = float(cmd_pA[last_thr_idx])
    I_end = float(cmd_pA[ramp_b - 1]) if ramp_b > 0 else np.nan
    if not np.isfinite(I_last) or not np.isfinite(I_end):
        return out
    if (I_end - I_last) < RHEO_BLOCK_MIN_CURRENT_CONTINUE_PA:
        return out

    post_start = last_peak_idx + int((RHEO_BLOCK_POST_START_MS / 1000.0) * fs)
    post_start = max(post_start, last_peak_idx + 1)
    post_end = ramp_b
    if post_end <= post_start + 5:
        return out

    plateau_seg = v[post_start:post_end].astype(float)
    if plateau_seg.size < 5:
        return out

    plateau_vm = float(np.median(plateau_seg))
    if plateau_vm < RHEO_BLOCK_PLATEAU_MIN_MV:
        return out

    out["Ramp_DepolBlock_bool"] = 1.0
    out["Ramp_DepolBlock_Current_pA"] = float(I_last)
    out["Ramp_DepolBlock_Vm_mV"] = float(plateau_vm)
    return out


# =========================
# IVCC: FIXED STEP-WINDOW analysis
# =========================
def analyze_ivcc(abf: pyabf.ABF):
    fs = get_fs(abf)
    steps_expected = np.arange(
        IVCC_STEP_START_PA,
        IVCC_STEP_END_PA + 0.5 * IVCC_STEP_DELTA_PA,
        IVCC_STEP_DELTA_PA,
    )

    per_step_rows = []
    one_ap_rows = []
    wave_snips = {}

    step_has_spike: Dict[float, bool] = {}
    tau_candidates = []
    sag_by_I: Dict[float, Tuple[float, float]] = {}
    rebound_by_I: Dict[float, Tuple[int, float]] = {}
    adapt_candidates = []

    for sw in range(abf.sweepCount):
        abf.setSweep(sw, channel=0)
        if abf.sweepUnitsY.lower() != "mv":
            continue

        v = abf.sweepY.astype(float)
        t = abf.sweepX.astype(float)

        try:
            cmd = abf.sweepC.astype(float)
            cmd_units = getattr(abf, "sweepUnitsC", None)
            cmd = cmd * unit_to_scale_to_pA(cmd_units)
        except Exception:
            cmd = None

        if cmd is None or cmd.size != v.size or t.size != v.size:
            continue

        a = idx_from_time(t, IVCC_STEP_WIN_START_S)
        b = idx_from_time(t, IVCC_STEP_WIN_END_S)
        if b <= a + int(0.05 * fs):
            continue

        rawI = float(np.median(cmd[a:b]))
        I = float(steps_expected[np.argmin(np.abs(steps_expected - rawI))])

        vss = step_steady_state(v, fs, a, b)
        seg = v[a:b]
        spikes = detect_spikes_dvdt(seg, fs, dvdt_thresh_V_per_s=DV_DT_THRESH_IVCC_V_PER_S)
        nsp = len(spikes)
        dur = (b - a) / fs
        freq = (nsp / dur) if dur > 0 else np.nan
        lat = (spikes[0]["thr_idx"] / fs) if spikes else np.nan
        if np.isfinite(lat) and lat > dur:
            lat = np.nan

        per_step_rows.append({
            "Sweep": sw,
            "Step_pA": float(I),
            "StepRaw_pA": float(rawI),
            "V_ss_mV": float(vss),
            "Spikes_N": int(nsp),
            "Freq_Hz": float(freq) if np.isfinite(freq) else np.nan,
            "FirstLatency_s": float(lat) if np.isfinite(lat) else np.nan,
        })

        step_has_spike[I] = (nsp > 0)

        if (I in TAU_FIT_STEPS_PA) and (I < 0) and (nsp == 0):
            tau_res = fit_tau_from_step(v, t, fs, a, b, fit_ms=TAU_FIT_WINDOW_MS)
            if np.isfinite(tau_res.get("tau_s", np.nan)) and tau_res["tau_s"] > 0:
                tau_res = dict(tau_res)
                tau_res["Sweep"] = int(sw)
                tau_res["Step_pA"] = float(I)
                tau_candidates.append(tau_res)

        if I < 0:
            sag, sag_ratio = compute_sag_metrics(v, fs, a, b)
            sag_by_I[I] = (float(sag), float(sag_ratio))
            nreb, lreb = detect_rebound_spikes(v, fs, b)
            rebound_by_I[I] = (int(nreb), float(lreb) if np.isfinite(lreb) else np.nan)

        if spikes and I > 0:
            s0 = spikes[0]
            thr_idx = a + s0["thr_idx"]
            peak_idx = a + s0["peak_idx"]

            feats = spike_features_from_indices(v, fs, thr_idx, peak_idx)
            feats["IVCC_1AP_Step_pA"] = float(I)
            feats["IVCC_1AP_Latency_s"] = float((thr_idx - a) / fs)
            one_ap_rows.append({"Sweep": sw, **feats})

            t_ms, v_snip, dvdt_snip = extract_peak_aligned_snippet(v, fs, peak_idx)
            wave_snips[sw] = {"t_ms": t_ms, "v_mV": v_snip, "dvdt_V_per_s": dvdt_snip, "Step_pA": float(I)}

        else:
            one_ap_rows.append({"Sweep": sw, "IVCC_1AP_Step_pA": np.nan})

        if I > 0:
            adapt_idx = adaptation_index_from_spikes(spikes, fs)
            if np.isfinite(adapt_idx):
                adapt_candidates.append({"Step_pA": float(I), "AdaptationIndex": float(adapt_idx)})

    df_steps = pd.DataFrame(per_step_rows)
    df_1ap = pd.DataFrame(one_ap_rows)

    rin_mohm = np.nan
    if not df_steps.empty:
        sub = df_steps[(df_steps["Spikes_N"] == 0) & (df_steps["Step_pA"].notna()) & (df_steps["V_ss_mV"].notna())]
        if not sub.empty:
            I_arr = sub["Step_pA"].astype(float).values
            V_arr = sub["V_ss_mV"].astype(float).values
            if np.unique(I_arr).size >= 3:
                m, _ = np.polyfit(I_arr, V_arr, 1)   # mV/pA = GOhm
                rin_mohm = float(m * 1000.0)         # MOhm

    tau_best = select_best_tau_candidate(tau_candidates)
    tau_s = float(tau_best["tau_s"]) if tau_best is not None and np.isfinite(tau_best.get("tau_s", np.nan)) else np.nan
    tau_ms = float(tau_s * 1000.0) if np.isfinite(tau_s) else np.nan
    tau_step_used = float(tau_best["Step_pA"]) if tau_best is not None and np.isfinite(tau_best.get("Step_pA", np.nan)) else np.nan
    tau_method = tau_best.get("method", "") if tau_best is not None else ""
    tau_r2 = float(tau_best["r2"]) if tau_best is not None and np.isfinite(tau_best.get("r2", np.nan)) else np.nan
    tau_rmse = float(tau_best["rmse_mV"]) if tau_best is not None and np.isfinite(tau_best.get("rmse_mV", np.nan)) else np.nan

    cm_pf = np.nan
    if np.isfinite(tau_s) and np.isfinite(rin_mohm) and rin_mohm > 0:
        cm_pf = float((tau_s / rin_mohm) * 1e6)

    sag_mV = np.nan
    sag_ratio = np.nan
    rebound_bool = np.nan
    rebound_n = np.nan
    rebound_lat = np.nan
    if sag_by_I:
        Ineg = min(sag_by_I.keys())
        sag_mV, sag_ratio = sag_by_I[Ineg]
        if Ineg in rebound_by_I:
            rebound_n, rebound_lat = rebound_by_I[Ineg]
            rebound_bool = float(1.0 if rebound_n > 0 else 0.0)

    step_rheo = np.nan
    pos_spiking = sorted([I for I, has in step_has_spike.items() if (I > 0 and has)])
    if pos_spiking:
        step_rheo = float(pos_spiking[0])

    max_step_freq = np.nan
    if not df_steps.empty:
        pos_freq = df_steps[(df_steps["Step_pA"] > 0) & (df_steps["Freq_Hz"].notna())]
        if not pos_freq.empty:
            max_step_freq = float(pos_freq["Freq_Hz"].max())

    fi_slope = np.nan
    if not df_steps.empty:
        g = df_steps[
            (df_steps["Step_pA"] >= FI_MIN_STEP_PA) &
            (df_steps["Step_pA"] <= FI_MAX_STEP_PA) &
            (df_steps["Spikes_N"] > 0) &
            (df_steps["Freq_Hz"].notna())
        ]
        if len(g) >= 3:
            I_arr = g["Step_pA"].astype(float).values
            F_arr = g["Freq_Hz"].astype(float).values
            m, _ = np.polyfit(I_arr, F_arr, 1)
            fi_slope = float(m)

    adaptation_index = np.nan
    adaptation_step = np.nan
    if adapt_candidates:
        adapt_df = pd.DataFrame(adapt_candidates).sort_values("Step_pA")
        adaptation_index = float(adapt_df.iloc[0]["AdaptationIndex"])
        adaptation_step = float(adapt_df.iloc[0]["Step_pA"])

    ap_peak = ap_amp_from_baseline = ap_halfwidth = np.nan
    ap_fahp_vmin = ap_fahp_depth = np.nan
    ap_mahp_vmin = ap_mahp_depth = np.nan
    ap_maxspeed = ap_baseline = np.nan
    selected_ap_step = np.nan

    if not df_1ap.empty and "IVCC_1AP_Step_pA" in df_1ap.columns:
        ap_ok = df_1ap[df_1ap["IVCC_1AP_Step_pA"].notna()].copy()
        if not ap_ok.empty:
            ap_ok = ap_ok.sort_values(["IVCC_1AP_Step_pA", "Sweep"])
            ap_sel = ap_ok.iloc[0]
            selected_ap_step = float(ap_sel["IVCC_1AP_Step_pA"])
            ap_peak = float(ap_sel["Vpeak_mV"]) if "Vpeak_mV" in ap_sel else np.nan
            ap_amp_from_baseline = float(ap_sel["AP_Amp_fromBaseline_mV"]) if "AP_Amp_fromBaseline_mV" in ap_sel else np.nan
            ap_halfwidth = float(ap_sel["Halfwidth_ms"]) if "Halfwidth_ms" in ap_sel else np.nan
            ap_fahp_vmin = float(ap_sel["fAHP_Vmin_mV"]) if "fAHP_Vmin_mV" in ap_sel else np.nan
            ap_fahp_depth = float(ap_sel["fAHP_Depth_mV"]) if "fAHP_Depth_mV" in ap_sel else np.nan
            ap_mahp_vmin = float(ap_sel["mAHP_Vmin_mV"]) if "mAHP_Vmin_mV" in ap_sel else np.nan
            ap_mahp_depth = float(ap_sel["mAHP_Depth_mV"]) if "mAHP_Depth_mV" in ap_sel else np.nan
            ap_maxspeed = float(ap_sel["Max_dVdt_V_per_s"]) if "Max_dVdt_V_per_s" in ap_sel else np.nan
            ap_baseline = float(ap_sel["LocalBaseline_mV"]) if "LocalBaseline_mV" in ap_sel else np.nan

    rin_gohm = (rin_mohm / 1000.0) if np.isfinite(rin_mohm) else np.nan

    summ = {
        "InputResistance_MOhm": float(rin_mohm) if np.isfinite(rin_mohm) else np.nan,
        "InputResistance_GOhm": float(rin_gohm) if np.isfinite(rin_gohm) else np.nan,
        "TimeConstant_ms": float(tau_ms) if np.isfinite(tau_ms) else np.nan,
