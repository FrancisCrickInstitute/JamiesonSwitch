#!/usr/bin/env python3
"""ABF current-clamp analysis: I0, IVCC, and ramp/rheobase.

Read mapping notes TXT and ABF files in INPUT_PATH. Export per-cell summaries,
quality-control logs, I0 firing-pattern classification, IV curves, and first-AP
waveforms to OUTPUT_PATH. PSC/voltage-clamp processing is intentionally excluded.

Dependencies: numpy, pandas, scipy, pyabf, openpyxl.
Classification thresholds are operational settings, not validated cell types.
"""
from __future__ import annotations

